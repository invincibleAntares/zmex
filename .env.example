# ZMEX — Environment Variables Example
#
# Copy this file to .env.local and fill in your real values.
# Never commit .env.local — it is git-ignored.
#
# Get your Neon connection string from: https://console.neon.tech

DATABASE_URL="postgresql://username:password@hostname/database?sslmode=require"
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
